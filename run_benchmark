#! /bin/bash

set -e

# maximum number of CPU cores available on the system
# (this respects even $SLURM_CPUS_PER_TASK when executed under Slurm)
NCPUS=$(nproc)

function run_benchmark()
{
    if (( $omp_threads > $NCPUS )); then
        return
    fi

    # set number of OpenMP threads
    omp_threads=${omp_threads:=1}
    if [[ "$omp_threads" == "1" ]]; then
        omp_enabled=false
    else
        omp_enabled=true
    fi

    local base="$(basename "$mesh_file")"
    if [[ "$base" = *.vtk ]]; then
        base="${base%.vtk}"
    elif [[ "$base" = *.vtu ]]; then
        base="${base%.vtu}"
    fi

    if [[ "$solver" =~ "cuda" ]]; then
        local log_file="log.CUDA_$base"
    else
        local log_file="log.OMP${omp_threads}_$base"
    fi

    local physcpubind="0-$(( $NCPUS - 1 ))"
    if [[ "$NCPUS" == 1 ]]; then
        physcpubind=0
    fi
    # do not bind for CUDA (numactl works under Slurm only when all CPU cores are allocated, otherwise IDs don't match)
    if [[ ! "$solver" =~ "cuda" ]]; then
        local solver="numactl --membind 0 --cpunodebind 0 --physcpubind $physcpubind $solver"
    fi

    ${solver} \
        --verbose 1 \
        --loops 100 \
        --mesh-file "$mesh_file" \
        --log-file "$log_file" \
        --openmp-enabled "$omp_enabled" \
        --openmp-max-threads "$omp_threads" \
        --benchmarks "$benchmarks" \
    || true
}

function run_set()
{
    for mesh_file in "${meshes[@]}"; do
        run_benchmark
    done
}

# benchmarks to run
#benchmarks="all"
#benchmarks="measures,spheres"
benchmarks="measures,boundary-measures"

# simplex meshes
meshes=(
    ./meshes/mrizka_{1..5}.rcm.vtk
    ./meshes/cube1m_{1..5}.vtk
)

# polygonal/polyhedral meshes
